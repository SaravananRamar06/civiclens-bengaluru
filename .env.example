CIVIC_LOCAL_MODE=true
# Cloud: false above; public HTTPS origin below, without a trailing slash.
APP_ORIGIN=
# Server runtime variables; NEXT_PUBLIC_* below remain compatibility aliases.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Operators are provisioned in civic_operators, never through browser metadata.
# For one persistent Node container (automatic on Vercel if these are unset):
# WORKFLOW_TARGET_WORLD=local
# WORKFLOW_LOCAL_DATA_DIR=.workflow-data
# WORKFLOW_LOCAL_BASE_URL=http://127.0.0.1:3000
