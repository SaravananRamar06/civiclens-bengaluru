# Local development works with only this line set.
CIVIC_LOCAL_MODE=true
# Optional: enables AI analysis locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cloud mode. On Vercel these come from the Supabase integration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only needed for a custom domain, with no trailing slash.
APP_ORIGIN=
